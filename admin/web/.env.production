ENV = 'production'

#下方为上线需要用到的程序代理前缀，一般用于nginx代理转发
VITE_BASE_API = /admin/api
VITE_FILE_API = /admin/api
#下方修改为你的线上ip（如果需要在线使用表单构建工具时使用，其余情况无需使用以下环境变量）
VITE_BASE_PATH =

# 编译后js导入的资源路径
JS_PATH = admin
BRAND_NAME=垣码平台
BRAND_LOGO_URL=/logo/logo.svg
BRAND_PRIMARY_COLOR=#1890ff
BRAND_FAVICON_URL=/favicon.ico
COPYRIGHT_TEXT=Copyright © 2025 我方公司 版权所有
VITE_BRAND_NAME=垣码平台管理中心
VITE_BRAND_LOGO_URL=/logo.png
VITE_COPYRIGHT_TEXT=Copyright © 2025 我方公司 版权所有
