ENV = 'development'
VITE_CLI_PORT = 8080
VITE_SERVER_PORT = 8888
VITE_BASE_API = /admin/api
VITE_FILE_API = /admin/api
VITE_BASE_PATH = http://127.0.0.1
VITE_POSITION = close
VITE_EDITOR = vscode
// VITE_EDITOR = webstorm 如果使用webstorm开发且要使用dom定位到代码行功能 请先自定添加 webstorm到环境变量 再将VITE_EDITOR值修改为webstorm
// 如果使用docker-compose开发模式，设置为下面的地址或本机主机IP
//VITE_BASE_PATH = http://177.7.0.12
# oa-oauth2.0登录客户端ID
VITE_OA_LOGIN_CLINET_ID =
# oa地址
VITE_OA_URL =

# 编译后js导入的资源路径
JS_PATH = admin

BRAND_NAME=垣码平台
BRAND_LOGO_URL=/logo/logo.svg
BRAND_PRIMARY_COLOR=#1890ff
BRAND_FAVICON_URL=/favicon.ico
COPYRIGHT_TEXT=Copyright © 2025 我方公司 版权所有
VITE_BRAND_NAME=垣码平台管理中心
VITE_BRAND_LOGO_URL=/logo.png
VITE_COPYRIGHT_TEXT=Copyright © 2025 我方公司 版权所有
